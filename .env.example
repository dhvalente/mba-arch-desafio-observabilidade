# Copie para .env antes de subir a stack: cp .env.example .env
# O compose le estas variaveis; sem o arquivo .env os servicos nao sobem.

# Postgres
POSTGRES_USER=loja
POSTGRES_PASSWORD=loja
POSTGRES_DB=loja

# Conexoes usadas pela api, pelo worker e pelo seed
DATABASE_URL=postgres://loja:loja@postgres:5432/loja
REDIS_URL=redis://redis:6379

# Portas dos processos Node
API_PORT=8080
WORKER_PORT=8081

# Endereco da API usado pelo gerador de carga
API_URL=http://api:8080

# Grafana
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
